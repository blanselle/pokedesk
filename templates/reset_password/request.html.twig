{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
    <div class="auth-card mx-auto">
        <h1 class="h3 mb-4">Mot de passe oublié</h1>

        <p>Saisissez votre adresse email : si elle correspond à un compte, vous recevrez un lien pour choisir un nouveau mot de passe.</p>

        {{ form_start(requestForm) }}
            {{ form_widget(requestForm) }}
            <button type="submit" class="btn btn-primary w-100">Envoyer le lien</button>
        {{ form_end(requestForm) }}

        <p class="mt-4 small"><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
    </div>
{% endblock %}
