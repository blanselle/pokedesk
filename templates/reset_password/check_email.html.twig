{% extends 'base.html.twig' %}

{% block title %}Vérifiez votre boîte mail{% endblock %}

{% block body %}
    <div class="auth-card mx-auto">
        <h1 class="h3 mb-4">Vérifiez votre boîte mail</h1>

        <p>Si un compte correspond à cette adresse, un email contenant un lien de réinitialisation vient d'être envoyé. Ce lien est valable {{ tokenLifetime }} minutes.</p>
        <p class="small"><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
    </div>
{% endblock %}
