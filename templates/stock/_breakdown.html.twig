{# Expects title, param, rows, filters and empty_label: a count per value, each one a filter on the list. #}
{% macro line(row, param, filters, empty_label) %}
    {% set label = row.label is null ? empty_label : (param == 'language' ? row.label|upper : row.label) %}
    {% set active = row.key is not null and (filters[param] ?? null) == row.key %}
    <li class="d-flex justify-content-between align-items-center gap-2 py-1">
        {% if row.key is null %}
            <span class="text-body-secondary text-truncate">{{ label }}</span>
        {% else %}
            <a href="{{ path('app_stock', active ? filters|filter((value, key) => key != param) : filters|merge({(param): row.key})) }}" class="text-truncate{{ active ? ' fw-bold' : '' }}" title="{{ label }}"{{ active ? ' aria-current="true"' : '' }}>{{ label }}</a>
        {% endif %}
        <span class="text-nowrap">
            <span class="badge text-bg-secondary">{{ row.copies }}</span>
            <span class="small text-body-secondary">{{ row.lines }} réf.</span>
        </span>
    </li>
{% endmacro %}

<section class="card h-100" data-breakdown="{{ param }}">
    <div class="card-body">
        <h2 class="h6 card-title">{{ title }}</h2>
        <ul class="list-unstyled small mb-0">
            {% for row in rows|slice(0, 5) %}
                {{ _self.line(row, param, filters, empty_label) }}
            {% endfor %}
        </ul>
        {% if rows|length > 5 %}
            <details class="small mt-1">
                <summary class="text-body-secondary">Voir les {{ rows|length - 5 }} autres</summary>
                <ul class="list-unstyled small mb-0">
                    {% for row in rows|slice(5) %}
                        {{ _self.line(row, param, filters, empty_label) }}
                    {% endfor %}
                </ul>
            </details>
        {% endif %}
    </div>
</section>
