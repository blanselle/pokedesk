{% extends 'base.html.twig' %}

{% block title %}Retirer du stock{% endblock %}

{% block body %}
    <h1 class="h4 mb-3">Retirer {{ lines|length > 1 ? 'ces cartes' : 'cette carte' }} de votre stock ?</h1>
    <p class="text-body-secondary">
        {{ lines|length }} ligne{{ lines|length > 1 ? 's' : '' }} et {{ copies }} exemplaire{{ copies > 1 ? 's' : '' }} seront supprimés. Cette action est définitive.
    </p>

    <div class="table-responsive mb-3">
        <table class="table align-middle bg-body">
            <tbody>
                {% for line in lines %}
                    <tr>
                        <td style="width: 4rem">
                            {% if line.card.imagePath %}<img src="{{ path('card_image', {id: line.card.id}) }}" alt="" width="44" class="rounded">{% endif %}
                        </td>
                        <td>
                            <div class="fw-semibold">{{ line.card.name }}</div>
                            <div class="small text-body-secondary">{{ line.card.set.name }} · n° {{ line.card.localId }}</div>
                        </td>
                        <td class="text-uppercase">{{ line.card.language }}</td>
                        <td class="text-end">×{{ line.quantity }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {{ form_start(form) }}
        {% for line in lines %}
            <input type="hidden" name="{{ form.ids.vars.full_name }}[]" value="{{ line.id }}">
        {% endfor %}
        {{ form_widget(form._token) }}
        <div class="d-flex gap-2">
            {{ form_widget(form.confirm, {attr: {class: 'btn btn-danger'}}) }}
            <a href="{{ path('app_stock', query) }}" class="btn btn-outline-secondary">Annuler</a>
        </div>
    {{ form_end(form, {render_rest: false}) }}
{% endblock %}
